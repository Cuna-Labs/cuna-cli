{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getcuna.com/schemas/cuna-cli-support-policy-v2.json",
  "title": "Cuna CLI support and distribution policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageName", "canonicalRegistry", "architectures", "node", "protocolRange", "approvedRealHosts", "ciMatrix", "preGaExternalEvidence", "channelOrder", "channels"],
  "properties": {
    "schemaVersion": {"const": 2},
    "packageName": {"const": "@cuna_labs/cli"},
    "canonicalRegistry": {"const": "https://registry.npmjs.org"},
    "architectures": {"const": ["x64", "arm64"]},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "supportedLines", "tested"],
      "properties": {
        "minimum": {"const": "22.17.1"},
        "supportedLines": {"const": ["22.17.1", "24.4.1"]},
        "tested": {"const": ["22.17.1", "24.4.1"]}
      }
    },
    "protocolRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"const": "1"},
        "maximum": {"const": "1"}
      }
    },
    "approvedRealHosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/approvedRealHost"}
    },
    "ciMatrix": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ciMatrixEntry"},
      "allOf": [
        {"contains": {"type": "object", "required": ["platform", "architecture", "node"], "not": {"required": ["claim"]}, "properties": {"platform": {"const": "linux"}, "architecture": {"const": "x64"}, "node": {"const": "22.17.1"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node"], "not": {"required": ["claim"]}, "properties": {"platform": {"const": "linux"}, "architecture": {"const": "x64"}, "node": {"const": "24.4.1"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node"], "not": {"required": ["claim"]}, "properties": {"platform": {"const": "darwin"}, "architecture": {"const": "x64"}, "node": {"const": "22.17.1"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node"], "not": {"required": ["claim"]}, "properties": {"platform": {"const": "darwin"}, "architecture": {"const": "x64"}, "node": {"const": "24.4.1"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node"], "not": {"required": ["claim"]}, "properties": {"platform": {"const": "win32"}, "architecture": {"const": "x64"}, "node": {"const": "22.17.1"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node"], "not": {"required": ["claim"]}, "properties": {"platform": {"const": "win32"}, "architecture": {"const": "x64"}, "node": {"const": "24.4.1"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node", "claim"], "properties": {"platform": {"const": "linux"}, "architecture": {"const": "arm64"}, "node": {"const": "22.17.1"}, "claim": {"const": "observation-only"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node", "claim"], "properties": {"platform": {"const": "linux"}, "architecture": {"const": "arm64"}, "node": {"const": "24.4.1"}, "claim": {"const": "observation-only"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node", "claim"], "properties": {"platform": {"const": "darwin"}, "architecture": {"const": "arm64"}, "node": {"const": "22.17.1"}, "claim": {"const": "observation-only"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node", "claim"], "properties": {"platform": {"const": "darwin"}, "architecture": {"const": "arm64"}, "node": {"const": "24.4.1"}, "claim": {"const": "observation-only"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node", "claim"], "properties": {"platform": {"const": "win32"}, "architecture": {"const": "arm64"}, "node": {"const": "22.17.1"}, "claim": {"const": "observation-only"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["platform", "architecture", "node", "claim"], "properties": {"platform": {"const": "win32"}, "architecture": {"const": "arm64"}, "node": {"const": "24.4.1"}, "claim": {"const": "observation-only"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "preGaExternalEvidence": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
    "channelOrder": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["npm", "bun", "curl", "homebrew", "aur"]}},
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npm", "bun", "curl", "homebrew", "aur"],
      "properties": {
        "npm": {"allOf": [{"$ref": "#/$defs/channel"}, {"properties": {"role": {"const": "canonical-artifact"}, "installerOfRecord": {"const": "npm"}, "blockedPlatforms": {"const": []}, "candidateInvocationPolicy": {"const": "npm-exact-version"}}}]},
        "bun": {"allOf": [{"$ref": "#/$defs/channel"}, {"properties": {"role": {"const": "registry-projection"}, "installerOfRecord": {"const": "bun"}, "platforms": {"const": ["linux-x64", "darwin-x64"]}, "blockedPlatforms": {"const": [{"platform": "win32-x64", "availability": "RELEASE_BLOCKED", "reasonCode": "BUN_WINDOWS_GLOBAL_UNINSTALL_LEAVES_SHIMS", "verifiedAffectedVersions": ["1.3.14"], "upstreamRepository": "oven-sh/bun", "upstreamCommit": "0d9b296af33f2b851fcbf4df3e9ec89751734ba4", "fallbackChannel": "npm", "readmissionGate": "A supported Bun release must prove isolated global install, public-shim execution, global uninstall, and zero remaining package-managed paths on every Windows Tier-1 Node lane."}]}, "candidateInvocationPolicy": {"const": "bun-exact-version"}}}]},
        "curl": {"allOf": [{"$ref": "#/$defs/channel"}, {"properties": {"role": {"const": "bootstrap-projection"}, "installerOfRecord": {"const": "npm"}, "blockedPlatforms": {"const": []}, "candidateInvocationPolicy": {"const": "verified-projection"}}}]},
        "homebrew": {"allOf": [{"$ref": "#/$defs/channel"}, {"properties": {"role": {"const": "formula-projection"}, "installerOfRecord": {"const": "homebrew"}, "blockedPlatforms": {"const": []}, "candidateInvocationPolicy": {"const": "verified-projection"}, "runtimeDependency": {"pattern": "^[a-z0-9@+_.-]+$"}}}]},
        "aur": {"allOf": [{"$ref": "#/$defs/channel"}, {"properties": {"role": {"const": "package-projection"}, "installerOfRecord": {"const": "pacman"}, "blockedPlatforms": {"const": []}, "candidateInvocationPolicy": {"const": "verified-projection"}, "runtimeDependency": {"pattern": "^[a-z0-9@+_.-]+(?:[<>=]+[0-9][0-9A-Za-z.+_-]*)?$"}}}]}
      }
    }
  },
  "$defs": {
    "approvedRealHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerImage", "platform", "architecture", "node"],
      "properties": {
        "runnerImage": {"type": "string", "pattern": "^policy-approved:[A-Za-z0-9][A-Za-z0-9._:-]{2,111}$"},
        "platform": {"enum": ["linux", "darwin", "win32"]},
        "architecture": {"enum": ["x64", "arm64"]},
        "node": {"enum": ["22.17.1", "24.4.1"]}
      }
    },
    "ciMatrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runner", "platform", "architecture", "node"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "runner": {"type": "string", "minLength": 1},
        "platform": {"enum": ["linux", "darwin", "win32"]},
        "architecture": {"type": "string", "minLength": 1},
        "node": {"enum": ["22.17.1", "24.4.1"]},
        "claim": {"const": "observation-only"}
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "availability", "artifactChannel", "installerOfRecord", "platforms", "blockedPlatforms", "projectionFile", "publicCommand", "candidateInvocationPolicy", "testedNodeVersions", "runtimeDependency"],
      "properties": {
        "role": {"enum": ["canonical-artifact", "registry-projection", "bootstrap-projection", "formula-projection", "package-projection"]},
        "availability": {"const": "PROJECTED_NOT_PUBLISHED"},
        "artifactChannel": {"const": "npm"},
        "installerOfRecord": {"enum": ["npm", "bun", "homebrew", "pacman"]},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["linux-x64", "darwin-x64", "win32-x64"]}},
        "blockedPlatforms": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/blockedPlatform"}},
        "projectionFile": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
        "publicCommand": {"type": "string", "minLength": 1},
        "candidateInvocationPolicy": {"enum": ["npm-exact-version", "bun-exact-version", "verified-projection"]},
        "testedNodeVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["22.17.1", "24.4.1"]}},
        "runtimeDependency": {"type": "string", "pattern": "^[A-Za-z0-9@^.+:/|><= _-]+$"}
      }
    },
    "blockedPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "availability", "reasonCode", "verifiedAffectedVersions", "upstreamRepository", "upstreamCommit", "fallbackChannel", "readmissionGate"],
      "properties": {
        "platform": {"enum": ["linux-x64", "darwin-x64", "win32-x64"]},
        "availability": {"const": "RELEASE_BLOCKED"},
        "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{7,127}$"},
        "verifiedAffectedVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}},
        "upstreamRepository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "upstreamCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "fallbackChannel": {"enum": ["npm", "bun", "curl", "homebrew", "aur"]},
        "readmissionGate": {"type": "string", "minLength": 32, "maxLength": 512}
      }
    }
  }
}
