{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runacode.io/schemas/runa-cli-release-envelope-v2.json",
  "title": "Runa CLI immutable candidate release envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageName",
    "version",
    "sourceCommit",
    "repository",
    "registry",
    "tarball",
    "sbom",
    "supportPolicy",
    "releaseInputs",
    "identities",
    "authority",
    "builder"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "packageName": {"const": "@runa_laboratories/cli"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {"const": "Runa-Laboratories/runa-cli"},
    "registry": {"const": "https://registry.npmjs.org"},
    "tarball": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "url", "sha256", "size"],
      "properties": {
        "file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.tgz$"},
        "url": {"type": "string", "pattern": "^https://registry\\.npmjs\\.org/@runa_laboratories/cli/-/cli-[0-9A-Za-z.-]+\\.tgz$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "sbom": {"$ref": "#/$defs/digestFile"},
    "supportPolicy": {"$ref": "#/$defs/digestFile"},
    "releaseInputs": {"$ref": "#/$defs/digestFile"},
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockfileSha256", "dependencyClosureSha256", "contractSha256", "buildRecipeSha256", "toolchainSha256", "payloadSha256", "payloadFileCount"],
      "properties": {
        "lockfileSha256": {"$ref": "#/$defs/sha256"},
        "dependencyClosureSha256": {"$ref": "#/$defs/sha256"},
        "contractSha256": {"$ref": "#/$defs/sha256"},
        "buildRecipeSha256": {"$ref": "#/$defs/sha256"},
        "toolchainSha256": {"$ref": "#/$defs/sha256"},
        "payloadSha256": {"$ref": "#/$defs/sha256"},
        "payloadFileCount": {"type": "integer", "minimum": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "releaseEligible", "approval", "provenance"],
      "properties": {
        "phase": {"const": "CANDIDATE_BUILT"},
        "releaseEligible": {"const": false},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "environment", "receiptSha256"],
          "properties": {
            "state": {"const": "REQUIRED_NOT_PRESENT"},
            "environment": {"const": "npm"},
            "receiptSha256": {"type": "null"}
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "workflow", "receiptSha256"],
          "properties": {
            "state": {"const": "REQUIRED_NOT_PRESENT"},
            "workflow": {"const": ".github/workflows/ci.yml"},
            "receiptSha256": {"type": "null"}
          }
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "runId", "runAttempt"],
      "properties": {
        "workflow": {"const": ".github/workflows/ci.yml"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runAttempt": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digestFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
