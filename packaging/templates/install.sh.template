#!/bin/sh
set -eu

# Generated from an admitted Runa CLI release envelope. This template is not a
# live installer and must retain unresolved @@...@@ markers in source control.
PACKAGE='@runa_laboratories/cli'
VERSION='@@VERSION@@'
TARBALL_URL='@@TARBALL_URL@@'
TARBALL_SHA256='@@TARBALL_SHA256@@'

die() {
  printf '%s\n' "runa installer: $*" >&2
  exit 1
}

command -v node >/dev/null 2>&1 || die 'Node.js is required.'
command -v npm >/dev/null 2>&1 || die 'npm is required.'
command -v curl >/dev/null 2>&1 || die 'curl is required.'

tmp_dir="$(mktemp -d 2>/dev/null || mktemp -d -t runa-install)"
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
tarball="$tmp_dir/runa-cli.tgz"
stage_prefix="$tmp_dir/stage"

curl --proto '=https' --tlsv1.2 --fail --location --show-error \
  --output "$tarball" "$TARBALL_URL"

if command -v sha256sum >/dev/null 2>&1; then
  printf '%s  %s\n' "$TARBALL_SHA256" "$tarball" | sha256sum --check --strict >/dev/null
elif command -v shasum >/dev/null 2>&1; then
  actual="$(shasum -a 256 "$tarball" | awk '{print $1}')"
  [ "$actual" = "$TARBALL_SHA256" ] || die 'SHA-256 verification failed.'
else
  die 'A SHA-256 verifier is required.'
fi

printf '%s\n' "Verifying ${PACKAGE}@${VERSION} before changing the global installation."
npm install --global --ignore-scripts --offline --no-audit --no-fund --prefix "$stage_prefix" "$tarball"
staged_runa="$stage_prefix/bin/runa"
[ -x "$staged_runa" ] || die 'The staged runa executable is missing.'
"$staged_runa" self-test --offline --json >/dev/null || die 'Staged installed-artifact self-test failed.'
staged_identity="$("$staged_runa" version --json)"
EXPECTED_VERSION="$VERSION" node -e '
  const fs = require("node:fs");
  const record = JSON.parse(fs.readFileSync(0, "utf8"));
  const data = record && record.data;
  if (!data || data.version !== process.env.EXPECTED_VERSION || !/^[0-9a-f]{64}$/.test(data.buildDigest) || data.updateChannel !== "npm") process.exit(1);
' <<EOF || die 'Staged runtime identity does not match the admitted release.'
$staged_identity
EOF

printf '%s\n' "Installing ${PACKAGE}@${VERSION} from verified npm bytes."
npm install --global --ignore-scripts --offline --no-audit --no-fund "$tarball"
runa self-test --offline --json >/dev/null || die 'Installed-artifact self-test failed.'
active_identity="$(runa version --json)"
[ "$active_identity" = "$staged_identity" ] || die 'Active runtime identity differs from the verified staged identity.'
printf '%s\n' "$active_identity"
