# Generated from a candidate-bound Cuna CLI release envelope. Do not edit by hand.
pkgname=cuna-cli-bin
pkgver=@@AUR_VERSION@@
pkgrel=1
pkgdesc='Cuna cloud-agent CLI'
arch=('x86_64')
url='https://getcuna.com'
license=('Apache-2.0')
depends=('@@AUR_NODE_DEPENDENCY@@')
makedepends=('npm')
source=("cuna-cli-${pkgver}.tgz::@@TARBALL_URL@@")
sha256sums=('@@TARBALL_SHA256@@')

package() {
  local npm_cache="${srcdir}/npm-cache"
  mkdir -p "$npm_cache"
  npm install --global --offline --ignore-scripts --no-audit --no-fund \
    --cache "$npm_cache" \
    --prefix "${pkgdir}/usr" \
    "${srcdir}/cuna-cli-${pkgver}.tgz"

  "${pkgdir}/usr/bin/cuna" self-test --offline --json >/dev/null
  "${pkgdir}/usr/bin/cuna" version --json | grep -F '"version":"@@VERSION@@"' >/dev/null
}
